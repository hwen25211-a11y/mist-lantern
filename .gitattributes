* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.command text eol=lf
*.bat text eol=crlf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.png binary
*.jpg binary
*.ttf binary
*.blend binary
*.glb binary
# Unity serializes empty YAML values with a trailing space.
*.meta whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.mtl whitespace=-blank-at-eof
